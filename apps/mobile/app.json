{
  "expo": {
    "name": "RSTAR ONE",
    "slug": "rstar-one",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/rstar-tv-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "bundleIdentifier": "tv.rstar.one",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RSTAR ONE uses your location only when you tap Check in or Check out, to confirm office attendance. It never tracks you in the background."
      }
    },
    "android": {
      "package": "tv.rstar.one",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RSTAR ONE uses your location only when you tap Check in or Check out, to confirm office attendance. It never tracks you in the background.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
