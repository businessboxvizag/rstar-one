{
  "name": "@rstar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@rstar/shared": "workspace:*",
    "fastify": "5.4.0",
    "jose": "6.0.12",
    "pg": "8.16.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.16.5",
    "@types/pg": "8.15.4",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
