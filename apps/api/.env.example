# ── RSTAR ONE API ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of web origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://rstar:rstar@localhost:5432/rstar_one_dev
# Separate database used by `pnpm test` (it is wiped on every run)
TEST_DATABASE_URL=postgres://rstar:rstar@localhost:5432/rstar_one_test

# 64+ random chars each. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-generate-a-long-random-secret-value-here-000000
# 32-byte key, base64. Encrypts MFA secrets and sensitive HR fields at rest.
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# on | off  (keep "on" outside local development)
MFA_ENFORCEMENT=on

# First Super Admin created by `pnpm db:seed` (password must be changed at first login)
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_NAME=Owner
SEED_ADMIN_PASSWORD=
# true adds clearly-labelled demo employees and content (never in production)
SEED_DEMO_DATA=false

# Email delivery. "log" = TEST MODE: emails are written to the server log only.
MAIL_TRANSPORT=log
MAIL_FROM="RSTAR ONE <no-reply@example.com>"
SMTP_URL=
APP_BASE_URL=http://localhost:3000
