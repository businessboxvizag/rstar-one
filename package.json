{
  "name": "rstar-one",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** --filter ./apps/api --filter ./apps/web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter ./packages/** --filter ./apps/api run test",
    "db:migrate": "pnpm --filter @rstar/api run db:migrate",
    "db:seed": "pnpm --filter @rstar/api run db:seed",
    "dev:api": "pnpm --filter @rstar/api run dev",
    "dev:web": "pnpm --filter @rstar/web run dev"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
